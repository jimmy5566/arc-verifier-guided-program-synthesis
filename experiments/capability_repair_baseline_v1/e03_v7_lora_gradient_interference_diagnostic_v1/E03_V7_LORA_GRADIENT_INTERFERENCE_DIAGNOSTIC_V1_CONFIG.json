    "reconstruction": "eight B1 CE-numerator gradients summed per family microbatch 0 then divided by exact total supervised tokens",
    "rows": 72
  },
  "bootstrap": {
    "bounds": "2.5 and 97.5 percentiles of complete-statistic replicates",
    "method": "four microbatches independently resampled with replacement within each family; cross-family cosine pairs are not independent rows",
    "replicates": 10000,
    "seed": 20261010
  },
