{
  "registry_id": "macro_capability_registry_v1",
  "version": "v1",
  "llm_contract": "Macro IDs and symbolic parameter sources only. Canonical low-level primitive IDs are compiler-private.",
  "macros": [
    {"macro_id":"FIND_OBJECTS","input_concept":"Grid","output_concept":"Objects","semantics":"Perceive foreground objects under the standard deterministic object view.","allowed_parameter_sources":{},"preconditions":"Grid contains a deterministic foreground view.","valid_usage":"FIND_OBJECTS -> SELECT_OBJECT","does_not_do":"Does not select or alter an object.","compiler_mapping":"object_perception"},
    {"macro_id":"SELECT_OBJECT","input_concept":"Objects","output_concept":"SelectedObject","semantics":"Select one uniquely determined object by a semantic selector.","allowed_parameter_sources":{"selector":["LITERAL"]},"required_parameters":["selector"],"preconditions":"Exactly one object satisfies selector.","valid_usage":"FIND_OBJECTS -> SELECT_OBJECT(selector=largest)","does_not_do":"Does not modify the grid.","compiler_mapping":"legacy_selector"},
    {"macro_id":"TRANSFORM_OBJECT","input_concept":"SelectedObject","output_concept":"Grid","semantics":"Recolor, crop, or move a selected object using symbolic intent.","allowed_parameter_sources":{"operation":["LITERAL"],"color_source":["FROM_UNIQUE_COLOR","FROM_TRAIN_COLOR_MAPPING","FROM_SELECTED_OBJECT"],"translation":["INFER_FROM_TRAIN","TO_REFERENCE_POSITION"]},"required_parameters":["operation"],"preconditions":"Selected object and requested transform are unique.","valid_usage":"SELECT_OBJECT -> TRANSFORM_OBJECT(operation=recolor,color_source=FROM_UNIQUE_COLOR)","does_not_do":"Does not infer arbitrary object relations.","compiler_mapping":"legacy_object_transform"},
    {"macro_id":"COPY_OBJECT","input_concept":"SelectedObject","output_concept":"Grid","semantics":"Copy the selected object using a symbolic placement relation.","allowed_parameter_sources":{"translation":["INFER_FROM_TRAIN","TO_REFERENCE_POSITION","UNTIL_BOUNDARY"]},"required_parameters":["translation"],"preconditions":"Copy placement is unambiguous and in bounds.","valid_usage":"SELECT_OBJECT -> COPY_OBJECT(translation=INFER_FROM_TRAIN)","does_not_do":"Does not select a new object.","compiler_mapping":"legacy_object_copy"},
    {"macro_id":"ALIGN_OBJECTS","input_concept":"Objects","output_concept":"Grid","semantics":"Align a selected object against a reference object by an edge or center.","allowed_parameter_sources":{"alignment":["ALIGN_LEFT","ALIGN_RIGHT","ALIGN_TOP","ALIGN_BOTTOM","ALIGN_CENTER","RELATIVE_TO_REFERENCE"]},"required_parameters":["alignment"],"preconditions":"Selected and reference objects are unique.","valid_usage":"FIND_OBJECTS -> ALIGN_OBJECTS(alignment=ALIGN_LEFT)","does_not_do":"Does not perform free-form geometric search.","compiler_mapping":"legacy_object_align"},
    {"macro_id":"FIND_ENCLOSED_REGION","input_concept":"Grid","output_concept":"Region","semantics":"Identify background-connected holes fully enclosed by foreground boundaries.","allowed_parameter_sources":{},"preconditions":"An enclosed region exists.","valid_usage":"FIND_ENCLOSED_REGION -> FILL_ENCLOSED_REGION","does_not_do":"Does not color the region.","compiler_mapping":"enclosed_region_perception"},
    {"macro_id":"FILL_ENCLOSED_REGION","input_concept":"Grid","output_concept":"Grid","semantics":"Fill enclosed interior cells with a symbolically sourced color.","allowed_parameter_sources":{"color_source":["FROM_BOUNDARY","FROM_UNIQUE_COLOR","FROM_TRAIN_COLOR_MAPPING"]},"required_parameters":["color_source"],"preconditions":"A single fill color is train-consistent.","valid_usage":"FILL_ENCLOSED_REGION(color_source=FROM_BOUNDARY)","does_not_do":"Does not fill exterior background.","compiler_mapping":"fill_enclosed_region"},
    {"macro_id":"EXTRACT_REGION","input_concept":"Grid","output_concept":"Region","semantics":"Extract the region at a symbolically specified anchor.","allowed_parameter_sources":{"position":["FROM_SELECTED_OBJECT","RELATIVE_TO_REFERENCE","LITERAL"]},"required_parameters":["position"],"preconditions":"Anchor is in bounds.","valid_usage":"EXTRACT_REGION(position=LITERAL)","does_not_do":"Does not render an output grid.","compiler_mapping":"extract_region"},
    {"macro_id":"FIND_PATTERN","input_concept":"Grid","output_concept":"Pattern","semantics":"Detect a row, column, or tiled periodic structure.","allowed_parameter_sources":{"axis":["HORIZONTAL","VERTICAL","DETECTED_ROW_PERIOD","DETECTED_COLUMN_PERIOD","DETECTED_TILE_PERIOD"]},"preconditions":"A deterministic period exists.","valid_usage":"FIND_PATTERN -> COMPLETE_PATTERN","does_not_do":"Does not repair cells.","compiler_mapping":"pattern_perception"},
    {"macro_id":"COMPLETE_PATTERN","input_concept":"Pattern","output_concept":"Grid","semantics":"Complete a detected periodic pattern to a train-derived output shape.","allowed_parameter_sources":{"period":["DETECTED_ROW_PERIOD","DETECTED_COLUMN_PERIOD","DETECTED_TILE_PERIOD"],"output_shape":["FROM_TRAIN_OUTPUT_RELATION","SAME_AS_INPUT"]},"required_parameters":["period","output_shape"],"preconditions":"Period and output relation are unique.","valid_usage":"FIND_PATTERN -> COMPLETE_PATTERN(period=DETECTED_ROW_PERIOD,output_shape=FROM_TRAIN_OUTPUT_RELATION)","does_not_do":"Does not invent a new motif.","compiler_mapping":"pattern_complete"},
    {"macro_id":"REPAIR_PATTERN","input_concept":"Grid","output_concept":"Grid","semantics":"Repair cells violating a detected row period.","allowed_parameter_sources":{"period":["DETECTED_ROW_PERIOD"]},"required_parameters":["period"],"preconditions":"A unique non-trivial repair exists.","valid_usage":"REPAIR_PATTERN(period=DETECTED_ROW_PERIOD)","does_not_do":"Does not change already-consistent cells.","compiler_mapping":"pattern_repair"},
    {"macro_id":"COMPLETE_SYMMETRY","input_concept":"Grid","output_concept":"Grid","semantics":"Complete a horizontal, vertical, or diagonal symmetry.","allowed_parameter_sources":{"axis":["HORIZONTAL","VERTICAL","LITERAL"]},"required_parameters":["axis"],"preconditions":"Axis is train-consistent.","valid_usage":"COMPLETE_SYMMETRY(axis=HORIZONTAL)","does_not_do":"Does not choose an arbitrary symmetry.","compiler_mapping":"symmetry_complete"},
    {"macro_id":"FIND_PATH","input_concept":"Grid","output_concept":"Graph","semantics":"Build the 4-connected foreground pixel graph.","allowed_parameter_sources":{},"preconditions":"Foreground graph is well-formed.","valid_usage":"FIND_PATH -> TRACE_PATH","does_not_do":"Does not choose traversal direction.","compiler_mapping":"path_graph"},
    {"macro_id":"TRACE_PATH","input_concept":"Graph","output_concept":"Path","semantics":"Trace a simple path from a symbolically determined endpoint.","allowed_parameter_sources":{"direction":["PATH_ENDPOINT_ORDER","INFER_FROM_TRAIN"]},"required_parameters":["direction"],"preconditions":"Graph is a simple path and direction is unambiguous.","valid_usage":"FIND_PATH -> TRACE_PATH(direction=PATH_ENDPOINT_ORDER)","does_not_do":"Does not serialize path colors.","compiler_mapping":"path_trace"},
    {"macro_id":"SERIALIZE_PATH","input_concept":"Path","output_concept":"Grid","semantics":"Read path colors and render them as a row or column.","allowed_parameter_sources":{"orientation":["HORIZONTAL","VERTICAL","INFER_FROM_TRAIN"]},"required_parameters":["orientation"],"preconditions":"Output orientation is train-consistent.","valid_usage":"TRACE_PATH -> SERIALIZE_PATH(orientation=HORIZONTAL)","does_not_do":"Does not choose a path.","compiler_mapping":"path_serialize"},
    {"macro_id":"COUNT_STRUCTURES","input_concept":"Grid","output_concept":"Count","semantics":"Count objects, regions, runs, or colored cells.","allowed_parameter_sources":{"count_kind":["LITERAL"],"color_source":["FROM_UNIQUE_COLOR","LITERAL"]},"required_parameters":["count_kind"],"preconditions":"Counting target is explicit.","valid_usage":"COUNT_STRUCTURES(count_kind=OBJECT_COUNT)","does_not_do":"Does not render a grid.","compiler_mapping":"count"},
    {"macro_id":"GENERATE_FROM_COUNT","input_concept":"Count","output_concept":"Grid","semantics":"Generate a row, column, or rectangle using a previous symbolic count.","allowed_parameter_sources":{"shape_source":["SAME_AS_INPUT","FROM_TRAIN_OUTPUT_RELATION"],"color_source":["FROM_UNIQUE_COLOR","FROM_TRAIN_COLOR_MAPPING"],"orientation":["HORIZONTAL","VERTICAL"]},"required_parameters":["shape_source","color_source","orientation"],"preconditions":"Count and output style are train-consistent.","valid_usage":"COUNT_STRUCTURES -> GENERATE_FROM_COUNT(shape_source=SAME_AS_INPUT,color_source=FROM_UNIQUE_COLOR,orientation=HORIZONTAL)","does_not_do":"Does not infer a free-form image.","compiler_mapping":"generate_from_count"},
    {"macro_id":"EXTRACT_SEQUENCE","input_concept":"Grid","output_concept":"Sequence","semantics":"Extract a row or column color sequence.","allowed_parameter_sources":{"orientation":["HORIZONTAL","VERTICAL"],"position":["LITERAL","RELATIVE_TO_REFERENCE"]},"required_parameters":["orientation","position"],"preconditions":"Row or column is in bounds.","valid_usage":"EXTRACT_SEQUENCE(orientation=HORIZONTAL,position=LITERAL)","does_not_do":"Does not transform sequence values.","compiler_mapping":"sequence_extract"},
    {"macro_id":"TRANSFORM_SEQUENCE","input_concept":"Sequence","output_concept":"Sequence","semantics":"Reverse or repeat a color sequence.","allowed_parameter_sources":{"operation":["LITERAL"],"count_source":["OBJECT_COUNT","REGION_COUNT","RUN_COUNT"]},"required_parameters":["operation"],"preconditions":"Operation parameters are deterministic.","valid_usage":"EXTRACT_SEQUENCE -> TRANSFORM_SEQUENCE(operation=reverse)","does_not_do":"Does not render a grid.","compiler_mapping":"sequence_transform"},
    {"macro_id":"BUILD_GRID_FROM_SEQUENCE","input_concept":"Sequence","output_concept":"Grid","semantics":"Render a sequence as a horizontal or vertical grid.","allowed_parameter_sources":{"orientation":["HORIZONTAL","VERTICAL"]},"required_parameters":["orientation"],"preconditions":"Orientation is explicit.","valid_usage":"TRANSFORM_SEQUENCE -> BUILD_GRID_FROM_SEQUENCE(orientation=HORIZONTAL)","does_not_do":"Does not choose a sequence.","compiler_mapping":"sequence_build"},
    {"macro_id":"SPLIT_BY_SEPARATOR","input_concept":"Grid","output_concept":"GridPair","semantics":"Split a grid at a full horizontal or vertical separator.","allowed_parameter_sources":{"orientation":["HORIZONTAL","VERTICAL"],"position":["INFER_FROM_TRAIN","LITERAL"]},"required_parameters":["orientation","position"],"preconditions":"Exactly one selected full separator exists.","valid_usage":"SPLIT_BY_SEPARATOR(orientation=HORIZONTAL,position=INFER_FROM_TRAIN)","does_not_do":"Does not independently solve each panel.","compiler_mapping":"separator_split"},
    {"macro_id":"CONNECT_STRUCTURES","input_concept":"Grid","output_concept":"Grid","semantics":"Connect two aligned symbolic points using a sourced color.","allowed_parameter_sources":{"color_source":["FROM_UNIQUE_COLOR","FROM_SELECTED_OBJECT"],"position":["FROM_SELECTED_OBJECT","RELATIVE_TO_REFERENCE"]},"required_parameters":["position","color_source"],"preconditions":"Points are aligned and unique.","valid_usage":"CONNECT_STRUCTURES(position=RELATIVE_TO_REFERENCE,color_source=FROM_UNIQUE_COLOR)","does_not_do":"Does not connect diagonal points.","compiler_mapping":"connect_structures"},
    {"macro_id":"REPEAT_UNTIL_BOUNDARY","input_concept":"Grid","output_concept":"Grid","semantics":"Extend a line from a symbolic start and direction to the canvas boundary.","allowed_parameter_sources":{"direction":["INFER_FROM_TRAIN","HORIZONTAL","VERTICAL"],"color_source":["FROM_UNIQUE_COLOR","FROM_SELECTED_OBJECT"],"position":["FROM_SELECTED_OBJECT","RELATIVE_TO_REFERENCE"]},"required_parameters":["direction","color_source","position"],"preconditions":"Start and direction are unambiguous.","valid_usage":"REPEAT_UNTIL_BOUNDARY(direction=HORIZONTAL,color_source=FROM_UNIQUE_COLOR,position=FROM_SELECTED_OBJECT)","does_not_do":"Does not iterate arbitrary programs.","compiler_mapping":"extend_line"},
    {"macro_id":"PROPAGATE_PATTERN","input_concept":"Grid","output_concept":"Grid","semantics":"Repeat a foreground pattern by a train-inferred bounded translation.","allowed_parameter_sources":{"translation":["INFER_FROM_TRAIN","UNTIL_BOUNDARY"],"count_source":["OBJECT_COUNT","REGION_COUNT","RUN_COUNT"]},"required_parameters":["translation"],"preconditions":"Translation and repeat count are train-consistent.","valid_usage":"PROPAGATE_PATTERN(translation=INFER_FROM_TRAIN)","does_not_do":"Does not perform unbounded search.","compiler_mapping":"bounded_translation"}
  ]
}
